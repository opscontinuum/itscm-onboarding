# The answer store holds real organisational detail: names, phone numbers,
# OCIDs, MTD figures, incident narratives. It never belongs in a public repo.
.itscm/answers.yaml
.itscm/answers.*.yaml

# Discovery output: a complete inventory of a live tenancy.
discovery-output/
dr-resources.env
*.dr-resources.env

# Python bytecode. The plugin trust fingerprint hashes every file in the
# plugin directory, so a stray __pycache__ makes picoagent treat the plugin
# as changed and skip loading it until it is trusted again.
__pycache__/

# Working files
*.tmp
.DS_Store
